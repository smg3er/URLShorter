# Безопасный шаблон единственного рабочего URLShorter/.env.
# Скопируйте файл в .env и замените placeholder-значения.

# PostgreSQL: обычное подключение и прямое административное подключение initSQL.py
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=6432
POSTGRES_ADMIN_PORT=5432
POSTGRES_ADMIN_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=urls

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# API и короткие ссылки
API_HOST=127.0.0.1
API_PORT=8000
SHORT_URL_BASE_URL=https://example.test/
REDIS_TTL_SECONDS=600
HASHIDS_SALT=change-me
HASHIDS_MIN_LENGTH=6

# Отправка метрик
METRICS_PUSHGATEWAY=127.0.0.1:9091
METRICS_PUSH_INTERVAL=15

# Генератор нагрузки frontApp.py
FRONT_APP_API_URL=http://127.0.0.1:8000/api/v1/urls/short
FRONT_APP_DOMAINS_FILE=top10milliondomains.csv
FRONT_APP_TOP_SITES_COUNT=100000
FRONT_APP_THREADS=24
FRONT_APP_REQUESTS_PER_THREAD=10000
FRONT_APP_OTHER_SITE_EVERY_N_REQUESTS=25
FRONT_APP_REQUEST_TIMEOUT_SECONDS=10
