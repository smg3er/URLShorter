# Локальное окружение URLShorter. Скопируйте в .env и заполните реальными значениями.
# .env не коммитится (см. .gitignore). Дефолты в коде совпадают с текущими значениями (существующий техдолг).

# --- Подключение к PostgreSQL (контейнеры и приложение) ---
# Для приложения: 6432 - pgbouncer, 5432 - postgres напрямую
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=6432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeit
POSTGRES_DB=urls

# --- Подключение приложения к Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
